RewriteEngine On

Options -MultiViews

# Главная и остальные страницы — статика, WordPress только там, где нет файла
DirectoryIndex index.html index.php

# Ensure HTTPS (optional, but recommended)
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Старые адреса статической галереи
RewriteRule ^gallery\.html$ https://%{HTTP_HOST}/gallery [NC,R=301,L]
RewriteRule ^gallery/([^/]+)\.html$ https://%{HTTP_HOST}/gallery/$1 [NC,R=301,L]

# Remove .html extension
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^\.]+)$ $1.html [NC,L]

# Remove .php extension
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([^\.]+)$ $1.php [NC,L]

# BEGIN WordPress
# Блок между BEGIN и END WordPress может перезаписать при сохранении настроек постоянных ссылок
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteBase /
RewriteRule ^index\.php$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.php [L]
</IfModule>
# END WordPress
